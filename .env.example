# Database
DATABASE_URL=postgresql://soundsnap:soundsnap@localhost:5432/soundsnap

# Typesense
TYPESENSE_API_KEY=xyz
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# Storage
