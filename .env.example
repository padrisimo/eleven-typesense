LOCAL_STORAGE_PATH=./audio
LOCAL_SIGNING_SECRET=dev-secret
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_CREDENTIALS_PATH=
GCS_SIGNER_SERVICE_ACCOUNT=

# Generation
GENERATOR=mock
GENERATOR_FALLBACK_TO_MOCK=true
GENERATION_DAILY_LIMIT=10
ELEVENLABS_API_KEY=

# Production (Caddy)
DOMAIN=localhost
CADDY_EMAIL=admin@example.com
